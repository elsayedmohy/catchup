# ---------------------------------------------------------------------------
# Catchup - example environment file
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5099

# PostgreSQL connection used by the API.
# Uses the local development cluster created by scripts/dev-db.sh (port 5433).
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5433;Database=catchup;Username=postgres;Password=postgres

# JWT signing settings. Use a long random value (>= 32 chars) outside dev.
Jwt__Key=dev-secret-key-change-in-production-min-32-chars
Jwt__Issuer=CatchupApi
Jwt__Audience=CatchupApp
Jwt__ExpiryMinutes=60

# Comma-separated list of browser origins allowed to call the API.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:8081

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5099

# --- Mobile ---
# For a physical device use the LAN IP, e.g. http://192.168.1.20:5099
EXPO_PUBLIC_API_BASE_URL=http://localhost:5099
